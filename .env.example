# install.sh genera una contraseña aleatoria si este valor está vacío.
APP_USER=admin
APP_PASSWORD=
# El acceso inicial se hace mediante túnel SSH de PuTTY; no abrir a Internet.
BIND_IP=127.0.0.1
PORT=8000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
MODEL_OFFLINE=false
MAX_UPLOAD_MB=500
MAX_AUDIO_SECONDS=14400
MAX_QUEUED_JOBS=8
JOB_TIMEOUT_SECONDS=21600
RETENTION_HOURS=24
MEMORY_LIMIT=6g
CPU_LIMIT=4
DATA_DIR=/data
MODELS_DIR=/models

# Para un futuro proxy HTTPS: URL pública exacta y hostname, sin comodines.
PUBLIC_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1
